<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.1.0.0" name="QTranslateFix.app" />

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!-- Deliberately NOT requireAdministrator. Writing into Program Files
             needs elevation, but Options.json, the HKCU Run key, and the
             Start Menu/Desktop shortcuts belong to the actual logged-in user
             and must NOT be written under an elevated token - if UAC elevation
             is satisfied with a *different* administrator account's
             credentials (common on machines where the daily account is a
             standard user), the whole process runs as that other account and
             every "current user" path resolves to *their* profile instead.
             Confirmed via Microsoft Q&A: this is exactly why installations
             elevated this way silently write settings nobody can find
             afterwards. So this process starts unelevated, and only the
             specific step that needs admin rights (copying into Program
             Files, writing HKLM) relaunches itself elevated for just that
             step - see Deployer.ElevatedMove. -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
